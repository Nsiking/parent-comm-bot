# ---- Core ----
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
# Optional: require a code to create a new school account
SIGNUP_CODE=
# Where the SQLite file lives (use your Render persistent disk path, e.g. /var/data)
DATA_DIR=./data
# Max messages a school can send per day (cost/abuse guard)
DAILY_LIMIT=500

# ---- AI drafting (Anthropic). Leave blank to use built-in templates ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- SMS via Termii (https://termii.com). Blank = dry-run (logs only) ----
TERMII_API_KEY=
# dnd = reaches numbers on Do-Not-Disturb (recommended in Nigeria); generic = cheaper, may be blocked
TERMII_CHANNEL=dnd

# ---- WhatsApp Cloud API (Meta). Blank = dry-run ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-string
WHATSAPP_APP_SECRET=
# template = approved template (needed for business-initiated messages); text = free text (sandbox / 24h window only)
WHATSAPP_SEND_MODE=template
WHATSAPP_TEMPLATE_NAME=school_update
WHATSAPP_TEMPLATE_LANG=en
# If WhatsApp fails, resend the same message by SMS
FALLBACK_TO_SMS=true
